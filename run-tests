#!/usr/bin/env bash
# Runs the project's test suite from the current project directory, with the
# host database bridged onto 127.0.0.1. See with-db.
set -euo pipefail

if [[ -x vendor/bin/pest ]]; then
  exec with-db vendor/bin/pest "$@"
elif [[ -x vendor/bin/phpunit ]]; then
  exec with-db vendor/bin/phpunit "$@"
else
  echo "run-tests: no vendor/bin/pest or vendor/bin/phpunit here" >&2
  exit 1
fi
