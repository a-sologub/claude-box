# Host directory mounted at /workspace. Everything below it is visible to
# Claude Code; nothing else on the host is.
CLAUDE_BOX_WORKSPACE="$HOME/Work"

# Image name used by build and run.
CLAUDE_BOX_IMAGE="claude-code"

# Host DB address as seen from inside the container. Exported into the
# session as DB_HOST so nobody has to prefix commands with DB_HOST=...
CLAUDE_BOX_DB_HOST="host.containers.internal"

# Resource limits.
CLAUDE_BOX_MEMORY="8g"
CLAUDE_BOX_CPUS="4"
